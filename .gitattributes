# Normalize authored text across Blender, Unreal and web tooling
* text=auto
*.md text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.py text eol=lf
*.ini text eol=lf
*.uproject text eol=lf
*.uplugin text eol=lf
*.cs text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.ps1 text eol=crlf

# Editable and interchange binary assets
*.blend filter=lfs diff=lfs merge=lfs -text
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
*.ubulk filter=lfs diff=lfs merge=lfs -text
*.uexp filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.tif filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text

# High-resolution authoring textures; delivery textures are separate
blender/textures/**/*.png filter=lfs diff=lfs merge=lfs -text
blender/textures/**/*.jpg filter=lfs diff=lfs merge=lfs -text
blender/textures/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
blender/textures/**/*.tga filter=lfs diff=lfs merge=lfs -text
blender/textures/**/*.webp filter=lfs diff=lfs merge=lfs -text

# Browser assets must be real files, never Git LFS pointers.
# Reset LFS diff/merge drivers while preserving text/binary detection.
web/public/** -filter !diff !merge
web/public/**/*.json text eol=lf

.gitkeep -filter !diff !merge text eol=lf
